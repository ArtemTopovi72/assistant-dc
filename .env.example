# Copy to `.env` (same folder) and fill in. Loaded automatically by config.py.
# Real environment variables take precedence over anything set here.
# `.env` holds secrets — do not commit it.

# ── Voice (F5-TTS) ────────────────────────────────────────────────────────────
# Optional: without these the app runs with voice output off.
# The assistant's voice sample, 5-15 s of clean speech (.wav):
# ASSISTANT_REF_WAV=C:\path\to\voice.wav
# A Hugging Face repo (and file) with a Russian F5-TTS checkpoint; the setup
# script downloads it to model_212000.safetensors when it is missing:
# F5_WEIGHTS_REPO=
# F5_WEIGHTS_FILE=

# ── VK wall reading ───────────────────────────────────────────────────────────
# SPb afisha/excursion listings often live in VK groups. VK blocks scraping, so
# wall reading needs a service token. Without it those sources are skipped
# ("VK wall ... skipped — no VK_TOKEN configured" in the log).
# Get one at https://dev.vk.com -> create an app -> Service token.
VK_TOKEN=

# ── Deep research: generation budgets ─────────────────────────────────────────
# Ceilings on a single LLM generation. These exist so a model that degenerates
# into a repetition loop cannot burn the full context window. Raise only if
# reports are being cut short.
DR_PLAN_TOKENS=8192
DR_BRIEF_TOKEN_CEILING=2048
DR_SECTION_TOKEN_CEILING=32000

# ── Deep research: retrieval ──────────────────────────────────────────────────
# 0 = keep every page (the reranker then only reorders, it drops nothing).
DR_RERANK_TOP_K=0
# Comma-separated host substrings. e.g. restrict to Russian sites: .ru,.рф
DR_DOMAIN_WHITELIST=
DR_DOMAIN_BLACKLIST=

# ── LLM stream watchdog ───────────────────────────────────────────────────────
# Repetition guard: aborts when the SAME loop signature survives two checks,
# so ~2x CHECK_EVERY chars is the waste ceiling on a stuck model.
# Set LLM_REPEAT_CHECK_EVERY=0 to disable the guard entirely.
LLM_REPEAT_CHECK_EVERY=1200
LLM_REPEAT_MIN_SPAN=200
LLM_STREAM_MAX_SECONDS=600

# ── Telegram bot: fairness, quotas, limits ───────────────────────────────────
# One GPU serves every chat. The queue is round-robin BY CHAT; these cap how
# much any single user can occupy. Admins are exempt from all of them.
TG_MAX_QUEUED_PER_USER=3      # tasks one user may have waiting
TG_QUOTA_DEEP_RESEARCH=5      # per UTC day, 0 = unlimited
TG_QUOTA_IMAGE=40
TG_QUOTA_TASKS=200
TG_ETA_TASK_SEC=45            # only used to turn queue position into an ETA
TG_ETA_RESEARCH_SEC=900

# Login security for the logged-out password gate
TG_LOGIN_MAX_FAILS=5
# Self-hosted Bot API server (telegram-bot-api --local): lifts the 20 MB file cap to 2 GB
# App credentials from https://my.telegram.org/apps ("App configuration"
# block: App api_id is a number, App api_hash is 32 hex chars). With both
# set the app starts telegram-bot-api --local itself and uses it.
# TG_API_ID=1234567
# TG_API_HASH=0123456789abcdef0123456789abcdef
# TG_API_BASE=http://127.0.0.1:8081   # override only if the server runs elsewhere
TG_LOGIN_LOCKOUT_S=300
TG_SCRYPT_N_LOG2=14           # 2**14 scrypt iterations (~30 ms per hash)

# Documents longer than this are indexed into the user's library instead of
# being pasted into the prompt; reports longer than that also go out as a file.
TG_DOC_INLINE_CHARS=6000
TG_REPORT_FILE_CHARS=6000

# Supervision
TG_WATCHDOG_S=15              # thread liveness check interval
TG_TASK_MAX_S=3600            # force-cancel a task running longer than this

# ── Embeddings ───────────────────────────────────────────────────────────────
# BGE-M3 (1024-dim) replaced nomic-embed-text-v1.5 (768-dim): on Russian queries
# against an English corpus nomic scored 0.000 recall@10 on 10/10 queries,
# BGE-M3 scored 0.965. Changing this invalidates every stored vector —
# run `python reindex_embeddings.py` afterwards. EMBED_DIM must match the model.
EMBED_MODEL=text-embedding-bge-m3
EMBED_DIM=1024
# EMBED_BASE=http://localhost:1234   # defaults to LM_STUDIO_BASE
SANDBOX_IMAGE=assistant-sandbox:latest   # run_code image; built from docker/sandbox by the app (scripts/build_sandbox_image.cmd torch adds CPU torch)
